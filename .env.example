# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# On Windows the real file lives next to docker-compose.yml on the PC.

# Gateway token - generate a long random string (e.g. `openssl rand -hex 32`).
OPENCLAW_GATEWAY_TOKEN=change-me-generate-a-long-random-token

# The brain. Added when Mark is home (AS-10). Keep the spend cap set in the console.
ANTHROPIC_API_KEY=

# Chores app MCP admin JWT (AS-27, AS-28). Full family admin - treat as top secret.
# Referenced from openclaw.json as ${CHORES_MCP_TOKEN}. Never commit the real value.
CHORES_MCP_TOKEN=

# Speech-to-text provider key (AS-19) - fill after the accent test picks a winner.
# DEEPGRAM_API_KEY=
# or reuse OPENAI_API_KEY for gpt-4o-transcribe:
# OPENAI_API_KEY=

# imsg-over-SSH (per-host; PC targets the Mac tailnet IP; Mac brain would use mikee@host.docker.internal)
IMSG_SSH_TARGET=mikee@100.67.66.94
IMSG_SSH_KEY=/home/node/.ssh-imsg/id_ed25519
IMSG_SSH_KNOWN_HOSTS=/home/node/.ssh-imsg/known_hosts

# Mark's own iMessage handle (+63... form) for failover and reminder notices. Mac only.
MARK_IMESSAGE_HANDLE=
